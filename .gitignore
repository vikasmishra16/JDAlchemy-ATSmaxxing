.python-version

# pipenv
#   According to pypa.io, Pipfile is a locked version.
Pipfile
Pipfile.lock

# Poetry
#   Similar to Pipfile.lock, poetry.lock is ignored because it is mainly for
#   applications and not libraries, and also to avoid committing the
#   package's own dependencies which is undesirable.
poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is mainly for applications and not
#   libraries.
pdm.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/
#   paulolocoff/pypackages
__pypackages__/

